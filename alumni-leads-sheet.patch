 public/alumni-webinar-admin.html | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/public/alumni-webinar-admin.html b/public/alumni-webinar-admin.html
index 1019bc2..482f19d 100644
--- a/public/alumni-webinar-admin.html
+++ b/public/alumni-webinar-admin.html
@@ -83,7 +83,10 @@ body{font-family:'Inter',sans-serif}
             <div class="cms-title">Alumni Webinar CMS</div>
             <div class="cms-sub">Edit speaker, webinar details and CTA for each alumni webinar page</div>
           </div>
-          <button class="copy-link-btn" id="copy-link-btn" onclick="copyPageUrl()">🔗 Copy Link</button>
+          <div style="display:flex;gap:8px;flex-wrap:wrap">
