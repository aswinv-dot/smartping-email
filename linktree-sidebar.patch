From c4a23b4d66ed6dccd4b4d83f1a4d2a7d6cb3bb1e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 29 Sep 2026 07:38:04 +0000
Subject: [PATCH] Wrap linktree page in the CRM sidebar under Social Media x
 Linktree
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds a fourth sidebar group, "Social Media x Linktree", with one
entry (Linktree) pointing at /linktree.html. The page itself now
includes shell.css/shell.js like the rest of the CRM.

Note: this wraps the PUBLIC-facing linktree page in the internal
CRM sidebar/topbar too, since it's the same URL — anyone opening
the link from a social bio will now see the CRM chrome around it.
Flagged this before making the change; let me know if you'd rather
this page stay bare and only be reachable from within the CRM via
a plain link instead.

Kept the page's own full-bleed blue background and centered layout
by scoping those rules to .app-main (where shell.js now nests the
page's original content) instead of <body>.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LHzxqv9S6k47oG19wZF3Kx
---
 public/linktree.html | 10 ++++++++++
 public/shell.js      |  7 +++++++
 2 files changed, 17 insertions(+)

diff --git a/public/linktree.html b/public/linktree.html
index 5e96bf6..3ba23a9 100644
--- a/public/linktree.html
+++ b/public/linktree.html
@@ -12,6 +12,7 @@
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <title>TerraTern</title>
     <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
+    <link rel="stylesheet" href="/shell.css"/>
     <style>
         * {
             margin: 0;
@@ -280,7 +281,16 @@
                 font-size: 16px;
             }
         }
+
+        /* This page keeps its own full-bleed blue background and centered
+           layout even inside the CRM shell — .app-main just shifts right
+           to clear the sidebar, same as every other wrapped page. */
+        .app-main {
+            display: flex; flex-direction: column; align-items: center;
+            padding: 20px; background: #255cc1;
+        }
     </style>
+    <script src="/shell.js" defer></script>
 </head>
 <body>
     <div class="container">
diff --git a/public/shell.js b/public/shell.js
index 5b91630..afab93a 100644
--- a/public/shell.js
+++ b/public/shell.js
@@ -37,6 +37,13 @@
         { label: 'Dashboard', href: '/capi-dashboard.html', icon: '📊' },
       ],
     },
+    {
+      id: 'linktree',
+      name: 'Social Media x Linktree',
+      links: [
+        { label: 'Linktree', href: '/linktree.html', icon: '🔗' },
+      ],
+    },
   ];
 
   function getPref(key, fallback) {
-- 
