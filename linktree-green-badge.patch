From 00648a8de13f8bff3d06875d4e2929a87b60cedc Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 29 Sep 2026 11:13:55 +0000
Subject: [PATCH] Add green badge style option, matching gradient pattern of
 gold/red badges

---
 public/linktree-admin.html | 6 +++++-
 public/linktree.html       | 9 ++++++++-
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/public/linktree-admin.html b/public/linktree-admin.html
index 588374a..674f88a 100644
--- a/public/linktree-admin.html
+++ b/public/linktree-admin.html
@@ -103,6 +103,7 @@ body{font-family:'Inter',sans-serif}
 .lt-link-subtitle{font-size:10.5px;color:#4a5568;margin-left:22px;margin-top:2px;line-height:1.4}
 .lt-badge{display:inline-block;background:linear-gradient(135deg,#f1c819 0,#f39c12 100%);color:#00215c;font-size:8px;font-weight:700;padding:3px 6px;border-radius:8px;text-transform:uppercase}
 .lt-badge-urgent{background:linear-gradient(135deg,#ff4757 0,#e84118 100%);color:#fff}
+.lt-badge-green{background:linear-gradient(135deg,#2ecc71 0,#27ae60 100%);color:#fff}
 .lt-footer{text-align:center;color:#fff;margin-top:20px;padding-top:16px;border-top:1px solid rgba(255,255,255,.2)}
 .lt-contact{font-size:13px;font-weight:600;color:#f1c819;margin-bottom:4px}
 .lt-address{font-size:10px;color:#fff;margin-bottom:10px}
@@ -227,6 +228,7 @@ function badgeStyleOptions(sel) {
     { v: 'none', l: 'No badge' },
     { v: 'normal', l: 'Normal (gold)' },
     { v: 'urgent', l: 'Urgent (red, pulsing)' },
+    { v: 'green', l: 'Green' },
   ];
   return opts.map(o => `<option value="${o.v}"${o.v === sel ? ' selected' : ''}>${o.l}</option>`).join('');
 }
@@ -312,8 +314,10 @@ function renderPreview() {
     <div><span class="lt-stat-number">${s.number}</span><div class="lt-stat-label">${s.label}</div></div>`).join('');
 
   document.getElementById('pv-links').innerHTML = links.map(l => {
+    const badgeClass = l.badge && l.badge.style === 'urgent' ? ' lt-badge-urgent'
+      : l.badge && l.badge.style === 'green' ? ' lt-badge-green' : '';
     const badge = l.badge
-      ? `<span class="lt-badge${l.badge.style === 'urgent' ? ' lt-badge-urgent' : ''}">${l.badge.text}</span>`
+      ? `<span class="lt-badge${badgeClass}">${l.badge.text}</span>`
       : '';
     return `
       <div class="lt-link">
diff --git a/public/linktree.html b/public/linktree.html
index d8eb596..e29cb27 100644
--- a/public/linktree.html
+++ b/public/linktree.html
@@ -161,6 +161,11 @@
             animation: pulse 2s ease-in-out infinite;
         }
 
+        .badge-green {
+            background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
+            color: white;
+        }
+
         @keyframes pulse {
             0%, 100% { opacity: 1; }
             50% { opacity: 0.8; }
@@ -329,8 +334,10 @@
             </div>`).join('');
 
         document.getElementById('links-list').innerHTML = (cfg.links || []).map(l => {
+            const badgeClass = l.badge && l.badge.style === 'urgent' ? ' badge-urgent'
+                : l.badge && l.badge.style === 'green' ? ' badge-green' : '';
             const badge = l.badge
-                ? `<span class="badge${l.badge.style === 'urgent' ? ' badge-urgent' : ''}">${l.badge.text}</span>`
+                ? `<span class="badge${badgeClass}">${l.badge.text}</span>`
                 : '';
             return `
                 <a href="${l.url}" class="link-button">
-- 
